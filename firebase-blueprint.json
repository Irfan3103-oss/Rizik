{
  "entities": {
    "RestaurantInfo": {
      "title": "RestaurantInfo",
      "description": "Restaurant owner onboarding metadata and admin verification status.",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "minLength": 3, "maxLength": 240 },
        "area": { "type": "string", "minLength": 1, "maxLength": 80 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "restaurantType": {
          "type": "string",
          "enum": ["restaurant", "bakery", "sweet_shop", "cafe", "catering", "hotel_kitchen", "other"]
        },
        "tradeLicenseNumber": { "type": "string", "maxLength": 80 },
        "restaurantPhotoUrl": { "type": "string", "maxLength": 250000 },
        "licensePhotoUrl": { "type": "string", "maxLength": 250000 },
        "openingHours": { "type": "string", "minLength": 2, "maxLength": 80 },
        "approxDailySurplus": { "type": "string", "maxLength": 100 },
        "acceptedSafetyTerms": { "type": "boolean" },
        "verificationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "restaurantName",
        "ownerName",
        "phone",
        "address",
        "area",
        "city",
        "lat",
        "lng",
        "restaurantType",
        "openingHours",
        "acceptedSafetyTerms",
        "verificationStatus"
      ]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "User profile, role, preferences, and optional restaurant application details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "maxLength": 250000
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["user", "restaurantOwner", "recipient", "donor"]
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "organizationName": {
          "type": "string",
          "maxLength": 120
        },
        "businessName": {
          "type": "string",
          "maxLength": 120
        },
        "hours": {
          "type": "string",
          "maxLength": 80
        },
        "verified": {
          "type": "boolean"
        },
        "discoverable": {
          "type": "boolean"
        },
        "starterSeeded": {
          "type": "boolean"
        },
        "notificationsSeeded": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "enum": ["en", "bn"]
        },
        "savedRadiusKm": {
          "type": "number"
        },
        "restaurant": {
          "$ref": "#/entities/RestaurantInfo"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "area",
        "verified",
        "language",
        "savedRadiusKm",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserDirectoryProfile": {
      "title": "UserDirectoryProfile",
      "description": "Zero-PII public profile projection used by Find People directory and Messenger chat headers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "maxLength": 250000
        },
        "role": {
          "type": "string",
          "enum": ["user", "restaurantOwner", "recipient", "donor", "admin", "volunteer", "ngo", "organizer"]
        },
        "restaurantName": {
          "type": "string",
          "maxLength": 120
        },
        "restaurantType": {
          "type": "string",
          "maxLength": 40
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "verified": {
          "type": "boolean"
        },
        "discoverable": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "bio": {
          "type": "string",
          "maxLength": 400
        },
        "bioBn": {
          "type": "string",
          "maxLength": 500
        },
        "openingHours": {
          "type": "string",
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "handle",
        "role",
        "area",
        "verified",
        "discoverable",
        "online",
        "lastSeen",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII record (email, phone, street address) readable and writable strictly by the owner or admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "address": {
          "type": "string",
          "maxLength": 240
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Per-user block record preventing blocked users from messaging each other.",
      "type": "object",
      "properties": {
        "blockerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "blockedUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "blockedName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "blockedHandle": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["blockerUid", "blockedUid", "blockedName", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Personal real-time notification in a user's notification center.",
      "type": "object",
      "properties": {
        "recipientUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "senderUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": [
            "welcome",
            "complete_profile",
            "flash_rescue",
            "flash_near_you",
            "events_upcoming",
            "team_hello",
            "new_message",
            "new_conversation",
            "reply",
            "claim_accepted",
            "claim_request",
            "pickup_completed",
            "restaurant_status",
            "system"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "titleBn": { "type": "string", "maxLength": 180 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "bodyBn": { "type": "string", "maxLength": 600 },
        "read": { "type": "boolean" },
        "isStarter": { "type": "boolean" },
        "conversationId": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "claimId": { "type": "string", "maxLength": 128 },
        "linkTab": {
          "type": "string",
          "enum": ["discover", "inbox", "claims", "events", "donate", "account", "post", "donor", "admin"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "senderUid", "type", "title", "body", "read", "createdAt", "updatedAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Safety or abuse report filed by an authenticated user against another user or conversation.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "targetUserId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "minLength": 2, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "reviewed", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetUserId", "targetName", "reason", "status", "createdAt", "updatedAt"]
    },
    "FoodListing": {
      "title": "FoodListing",
