        "isRamadanSpecial": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "paused", "claimed", "expired"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
