  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Admin UIDs editable strictly in Firebase Console."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "User profile, role preferences, and restaurant onboarding info."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Strictly isolated user PII (email, phone, street address)."
    },
    "/users/{userId}/blocked/{targetId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Per-user block list preventing blocked users from messaging each other."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Per-user real-time notifications inbox including starter notifications."
    },
    "/users/{userId}/demoConversations/{convId}": {
      "schema": { "$ref": "#/entities/DemoConversation" },
      "description": "Isolated per-user demo persona 1-to-1 conversations readable/writable only by userId."
    },
    "/users/{userId}/demoMessages/{msgId}": {
      "schema": { "$ref": "#/entities/DemoMessage" },
      "description": "Isolated per-user demo persona messages readable/writable only by userId."
    },
    "/userDirectory/{userId}": {
      "schema": { "$ref": "#/entities/UserDirectoryProfile" },
      "description": "Zero-PII public user directory used by Find People & presence status."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Community group chat rooms for signed-in users."
    },
    "/rooms/{roomId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/RoomMember" },
      "description": "Room online presence and rate-limit state per user."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Community room real-time messages and reactions."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User & conversation abuse reports moderated by admins."
    },
    "/adminNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Admin inbox notifications for new restaurant applications and owner chat messages."
    },
    "/adminConversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AdminConversation" },
      "description": "Direct onboarding/verification chat conversations between admin and restaurant owners."
    },
    "/adminConversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/AdminChatMessage" },
      "description": "Real-time chat messages inside an admin-owner conversation."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/FoodListing" },
      "description": "Active and historical surplus food listings posted by verified donors."
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/FoodClaim" },
      "description": "Food rescue reservations and QR/manual handover records."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/DonorReview" },
      "description": "Verified donor pickup ratings and hygiene confirmations."
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/MonetaryDonation" },
      "description": "Monetary donations supporting food rescue, Iftar packs, Sadaqah, and Zakat."
    },
    "/shiftSignups/{signupId}": {
      "schema": { "$ref": "#/entities/VolunteerShiftSignup" },
      "description": "Volunteer shift signups and logged hours."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ChatConversation" },
      "description": "Messenger 1-to-1 and pickup coordination conversations."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a conversation, master-gated by parent participants and block status."
    }
  }
