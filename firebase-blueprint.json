        "quantity": { "type": "number" },
        "remainingQuantity": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pickupStart": { "type": "string", "maxLength": 64 },
        "pickupEnd": { "type": "string", "maxLength": 64 },
        "pickupAddress": { "type": "string", "minLength": 2, "maxLength": 240 },
        "safetyNote": { "type": "string", "maxLength": 400 },
        "preparedAt": { "type": "string", "maxLength": 64 },
        "consumeWithinHours": { "type": "number" },
        "storageMethod": { "type": "string", "enum": ["covered_hot", "covered_chilled", "sealed_dry", "room_temp"] },
