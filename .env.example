# Rizik — Environment Variables Template
# Copy this file to .env and populate with your Firebase project credentials

# Firebase Web Client Configuration (Vite client-accessible)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# Port for local dev server / Express proxy (defaults to 3000)
PORT=3000
NODE_ENV=development
