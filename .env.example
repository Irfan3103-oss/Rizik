# Server (all optional; see README > Setup guide > Environment variables)
PORT=3000
# Folder for aharforall.db and uploads/ (use a persistent disk when hosted)
DATA_DIR=
# true = keep seeded demo food active on long-running hosts
DEMO_MODE=
# true = return OTP codes in API responses (demo only: allows account takeover)
EXPOSE_DEV_OTP=
GEMINI_API_KEY=

# Website Firebase config (build time; falls back to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
